// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTA: En Prisma v7, la URL de conexión se configura en prisma.config.ts
  // y se pasa al constructor de PrismaClient, NO aquí en el schema.
}

// --- Modelo de Negocio (Multi-Tenant) ---

model Business {
  id             String   @id @default(cuid())
  name           String
  code           String?  @unique
  phone          String?
  address        String?
  createdAt      DateTime @default(now())

  // Planes y Suscripción
  plan           String    @default("FREE")        // FREE, STANDARD, PRO, ENTERPRISE
  planStatus     String    @default("ACTIVE")      // ACTIVE, SUSPENDED, EXPIRED, CANCELLED
  planExpiresAt  DateTime?                         // Fecha de vencimiento / renovación
  billingCycle   String    @default("monthly")     // monthly, annual

  // Configuración del comercio
  enableJukebox  Boolean  @default(true)
  enableQrOrders Boolean  @default(true)
  alertSound     String   @default("ping")

  // Relaciones
  users          User[]
  tables         TableSession[]
  songRequests   SongRequest[]
  products       Product[]
  categories     Category[]
  orders         Order[]
  sales          Sale[]
  subscriptions  SubscriptionInvoice[]
}

// --- Modelo de Usuarios y Autenticación ---

model User {
  id         String    @id @default(cuid())
  email      String    @unique
  name       String?
  password   String
  role       String    @default("USER") // USER, ADMIN, SUPERADMIN
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  businessId String?
  business   Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)
}

// --- Gestión de Mesas y Salón ---

model TableSession {
  id         String   @id @default(cuid())
  tableId    String   // "1", "2", "mesa-1", etc.
  nickname   String   @default("Mesa")
  capacity   Int      @default(4)
  status     String   @default("free") // free, occupied
  waiter     String?
  comment    String?
  guestCount Int?     @default(1)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  // Relaciones
  songRequests SongRequest[]
  products     TableProduct[]
  orders       Order[]

  @@unique([businessId, tableId])
}

// --- Catálogo y Productos ---

model Category {
  id         String    @id @default(cuid())
  name       String
  icon       String?   @default("🍔")
  createdAt  DateTime  @default(now())

  businessId String
  business   Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  products   Product[]

  @@unique([businessId, name])
}

model Product {
  id          String   @id @default(cuid())
  name        String
  category    String   @default("General")
  price       Float    @default(0)
  stock       String   @default("disponible") // disponible, agotado
  description String?
  imageUrl    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  businessId  String
  business    Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)

  categoryId  String?
  categoryRef Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tables      TableProduct[]
  orderItems  OrderItem[]
}

model TableProduct {
  tableSessionId String
  productId      String
  quantity       Int          @default(1)
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)
  product        Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([tableSessionId, productId])
}

// --- Pedidos y Comandas en Mesa ---

model Order {
  id             String       @id @default(cuid())
  orderNumber    Int          @default(autoincrement())
  status         String       @default("PENDING") // PENDING, PREPARING, SERVED, PAID, CANCELLED
  total          Float        @default(0)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  tableSessionId String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id], onDelete: Cascade)

  businessId     String
  business       Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)

  items          OrderItem[]
}

model OrderItem {
  id          String   @id @default(cuid())
  quantity    Int      @default(1)
  unitPrice   Float
  notes       String?
  productName String   // Histórico del nombre al momento del pedido

  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId   String?
  product     Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
}

// --- Facturación y Registro de Ventas ---

model Sale {
  id            String   @id @default(cuid())
  invoiceNumber String   // "FAC-1001"
  table         String   // "Mesa 1"
  subtotal      Float    @default(0)
  tip           Float    @default(0)
  total         Float
  paymentMethod String   @default("Efectivo") // Efectivo, Tarjeta, Transferencia
  cashReceived  Float?
  change        Float?
  status        String   @default("Completado") // Completado, Cancelado
  waiter        String?
  guestCount    Int?     @default(1)
  saleType      String?  @default("Mesas")
  itemsCount    Int?     @default(0)
  createdAt     DateTime @default(now())

  businessId    String
  business      Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// --- Jukebox / Rockola ---

model SongRequest {
  id           String   @id @default(cuid())
  youtubeId    String
  title        String
  artist       String
  thumbnailUrl String
  status       String   @default("PENDING") // PENDING, PLAYING, PLAYED
  createdAt    DateTime @default(now())

  // Relación con la mesa que la pidió
  requestedById String
  requestedBy   TableSession @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// --- Facturas y Cobros de Suscripción (Planes) ---

model SubscriptionInvoice {
  id              String   @id @default(cuid())
  invoiceNumber   String   // "SUB-1001"
  plan            String   // "FREE", "STANDARD", "PRO", "ENTERPRISE"
  amount          Float    // 69000, 119000, 249000
  billingCycle    String   @default("monthly") // monthly, annual
  paymentMethod   String   @default("Tarjeta") // Wompi, Nequi, Bancolombia, Transferencia, AdminManual
  status          String   @default("PAID")    // PAID, FAILED, PENDING, REJECTED
  referenceNumber String?  // Número de comprobante Nequi/Bancolombia o Transaction ID Wompi
  notes           String?  // Notas del cliente o motivo de rechazo
  periodStart     DateTime @default(now())
  periodEnd       DateTime
  createdAt       DateTime @default(now())

  businessId      String
  business        Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
}

// --- Configuración Global del Sistema (Migrada a PostgreSQL) ---

model SystemConfig {
  id        String   @id @default("default")
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
