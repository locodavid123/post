// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // NOTA: En Prisma v7, la URL de conexión se configura en prisma.config.ts
  // y se pasa al constructor de PrismaClient, NO aquí en el schema.
}


// --- Modelos para la Jukebox ---

model TableSession {
  id        String   @id @default(cuid())
  tableId   String   // "mesa-1", "terraza-2", etc.
  nickname  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // Relaciones
  songRequests SongRequest[]
  products     TableProduct[]

  @@unique([businessId, tableId])
}

model SongRequest {
  id           String   @id @default(cuid())
  youtubeId    String
  title        String
  artist       String
  thumbnailUrl String
  status       String   @default("PENDING") // PENDING, PLAYING, PLAYED
  createdAt    DateTime @default(now())

  // Relación con la mesa que la pidió
  requestedById String
  requestedBy   TableSession @relation(fields: [requestedById], references: [id], onDelete: Cascade)
  
  businessId    String
  business      Business     @relation(fields: [businessId], references: [id])
}

// --- Modelos para la futura funcionalidad de Productos ---

model Product {
  id    String @id @default(cuid())
  name  String
  // Podrías añadir más campos como description, imageUrl, etc.

  businessId String
  business   Business @relation(fields: [businessId], references: [id])

  // Relación
  tables TableProduct[]
}

model TableProduct {
  tableSessionId String
  productId      String
  tableSession   TableSession @relation(fields: [tableSessionId], references: [id])
  product        Product      @relation(fields: [productId], references: [id])

  @@id([tableSessionId, productId])
}

// --- Modelo de usuarios para autenticación ---
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  password  String
  role      String   @default("USER") // USER, ADMIN
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  businessId String? 
  business   Business? @relation(fields: [businessId], references: [id])
}

model Business {
  id        String   @id @default(cuid())
  name      String
  code      String?  @unique
  phone     String?
  createdAt DateTime @default(now())

  // Configuration fields
  enableJukebox Boolean @default(true)
  enableQrOrders Boolean @default(true)
  alertSound     String  @default("ping")
  address        String?

  users        User[]
  tables       TableSession[]
  songRequests SongRequest[]
  products     Product[]
}

