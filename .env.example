# Configuración de Conexión a Base de Datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=123456
DB_DIALECT=postgres
DB_NAME=ecopost
DB_SSL=false

# URL de conexión directa para Prisma (opcional si se usan las variables DB_*)
DATABASE_URL=postgres://postgres:123456@localhost:5432/ecopost

# Clave secreta para firma y verificación de tokens JWT (¡Cambiar en producción!)
JWT_SECRET=super-secreto-cambiar-en-produccion

# Clave de API de Google para búsqueda de canciones en YouTube (Jukebox / Rockola)
YOUTUBE_API_KEY=tu_youtube_api_key_aqui

# Clave secreta opcional para crear usuarios con rol ADMIN desde /register
ADMIN_SECRET=clave-secreta-para-crear-admin

# Credenciales para el comando seed de Prisma (npm run seed)
ADMIN_EMAIL=admin@ecopost.local
ADMIN_PASSWORD=admin123
